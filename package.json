{
  "name": "chatwarden",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source chat moderation for games and anyone with a chat.",
  "license": "Apache-2.0",
  "engines": { "node": ">=22.13" },
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "build": "tsc -b",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -b",
    "check:pack": "npm run build && node scripts/check-pack.mjs",
    "smoke": "node scripts/smoke.mjs",
    "license:sync": "node scripts/sync-license.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
