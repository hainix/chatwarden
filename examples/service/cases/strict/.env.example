# The three variables the service reads. Copy this file to .env (Docker Compose reads it) and fill them in. Never commit .env.
# Written by `chatwarden init --service`. It is yours now: edit freely. Re-running never overwrites a file you changed.

# Keys the hashes of client keys and addresses: 32 or more characters. Keep it stable: changing it makes every returning player a new person.
# Make one with: openssl rand -base64 32
CHATWARDEN_SECRET=

# The service keys your game servers send as "Authorization: Bearer <key>": one to five, each 32 or more characters, comma separated. Use two while you rotate.
# Make one with: openssl rand -base64 32
CHATWARDEN_SERVICE_KEYS=

# The staff sign-in for the moderator hub: 24 or more characters, and not the same as a service key. Leave it empty to switch the staff side off.
CHATWARDEN_ADMIN_TOKEN=
