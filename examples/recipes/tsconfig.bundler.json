{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve"
  },
  "include": ["cases/next-*/**/*"],
  "exclude": ["cases/**/*.js", "cases/**/*.mjs", "cases/**/*.jsx"]
}
