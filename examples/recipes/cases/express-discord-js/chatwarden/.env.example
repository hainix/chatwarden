# Environment variables for Chatwarden. Copy to .env, or set these in your host.
# Written by `chatwarden init` (K4b). It is yours now: edit freely. Re-running never overwrites a file you changed.

# Keys the hashes of client keys and addresses: at least 32 characters, and keep it stable (changing it unlinks every stored hash).
# Make one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CHATWARDEN_SECRET=

# Signs staff in to the hub and the staff routes: at least 24 characters. Without it every staff route answers 401.
# This is a starter for one or two moderators; replace it with your own sign-in before a team uses it.
CHATWARDEN_ADMIN_TOKEN=

# Where the moderation database file lives. When empty it is ./chatwarden.db.
CHATWARDEN_DB=

# The forum channel webhook that new reports and outcomes are posted to. When empty the Discord feed is off.
DISCORD_WEBHOOK_URL=

# A Discord role to ping on a severe report or sanction. Optional.
DISCORD_MENTION_ROLE_ID=

# The public address of this server, for the links in Discord posts. When empty it is http://localhost:3000.
CHATWARDEN_PUBLIC_URL=
