    "@chatwarden/matcher": "0.1.2",
    "@chatwarden/profanity": "0.1.2",
    "@chatwarden/store-memory": "0.1.2",
    "@chatwarden/store-sqlite": "0.1.2",
    "express": "^5.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/ws": "^8.18.1"
