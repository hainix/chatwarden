{
  "name": "@chatwarden/store-sqlite",
  "version": "0.1.5",
  "private": false,
  "description": "SQLite store for Chatwarden chat moderation, on the SQLite built into Node: reports, sanctions, notices and the audit trail in one file.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "chatwarden",
    "moderation",
    "chat",
    "sqlite",
    "storage"
  ],
  "homepage": "https://github.com/hainix/chatwarden/tree/main/packages/store-sqlite#readme",
  "bugs": {
    "url": "https://github.com/hainix/chatwarden/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hainix/chatwarden.git",
    "directory": "packages/store-sqlite"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/src",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "peerDependencies": {
    "@chatwarden/core": "^0.1.5",
    "@chatwarden/matcher": "^0.1.0"
  },
  "devDependencies": {
    "@chatwarden/core": "0.1.5",
    "@chatwarden/matcher": "0.1.5",
    "@chatwarden/store-memory": "0.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
