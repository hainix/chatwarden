{
  "name": "@chatwarden/profanity",
  "version": "0.0.0",
  "private": false,
  "description": "Chatwarden optional profanity filter: ordinary swearing that a game can allow, star or refuse. Slurs are the matcher's job, not this package's.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hainix/chatwarden.git",
    "directory": "packages/profanity"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": ["dist/src"],
  "dependencies": { "@chatwarden/core": "0.0.0", "@chatwarden/matcher": "0.0.0", "obscenity": "^0.4.6" },
  "devDependencies": { "@chatwarden/store-sqlite": "0.0.0" },
  "publishConfig": { "access": "public" }
}
