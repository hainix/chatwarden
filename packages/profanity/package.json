{
  "name": "@chatwarden/profanity",
  "version": "0.1.9",
  "private": false,
  "description": "Chatwarden optional profanity filter: ordinary swearing that a game can allow, star or refuse. Slurs are the matcher's job, not this package's.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "chatwarden",
    "moderation",
    "chat",
    "profanity",
    "filter"
  ],
  "homepage": "https://github.com/hainix/chatwarden/tree/main/packages/profanity#readme",
  "bugs": {
    "url": "https://github.com/hainix/chatwarden/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hainix/chatwarden.git",
    "directory": "packages/profanity"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/src",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "dependencies": {
    "obscenity": "^0.4.6"
  },
  "devDependencies": {
    "@chatwarden/core": "0.1.9",
    "@chatwarden/matcher": "0.1.9",
    "@chatwarden/store-sqlite": "0.1.9"
  },
  "peerDependencies": {
    "@chatwarden/core": "^0.1.0",
    "@chatwarden/matcher": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
