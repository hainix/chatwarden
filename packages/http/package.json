{
  "name": "@chatwarden/http",
  "version": "0.1.6",
  "private": false,
  "description": "Chatwarden HTTP package: framework-free router, error mapping, auth hook and role permissions for the admin and player APIs.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "chatwarden",
    "moderation",
    "chat",
    "http",
    "api",
    "express"
  ],
  "homepage": "https://github.com/hainix/chatwarden/tree/main/packages/http#readme",
  "bugs": {
    "url": "https://github.com/hainix/chatwarden/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hainix/chatwarden.git",
    "directory": "packages/http"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./admin": {
      "types": "./dist/src/admin-entry.d.ts",
      "default": "./dist/src/admin-entry.js"
    },
    "./chat": {
      "types": "./dist/src/chat/index.d.ts",
      "default": "./dist/src/chat/index.js"
    },
    "./express": {
      "types": "./dist/src/express.d.ts",
      "default": "./dist/src/express.js"
    }
  },
  "typesVersions": {
    "*": {
      "admin": [
        "dist/src/admin-entry.d.ts"
      ],
      "chat": [
        "dist/src/chat/index.d.ts"
      ],
      "express": [
        "dist/src/express.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist/src",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "peerDependencies": {
    "@chatwarden/core": "^0.1.6",
    "@types/express": "^5.0.0",
    "express": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "@types/express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chatwarden/core": "0.1.6",
    "@chatwarden/discord": "0.1.6",
    "@chatwarden/matcher": "0.1.6",
    "@chatwarden/store-sqlite": "0.1.6",
    "@types/express": "^5.0.3",
    "express": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
