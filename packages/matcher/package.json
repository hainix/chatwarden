{
  "name": "@chatwarden/matcher",
  "version": "0.1.6",
  "private": false,
  "description": "Slur matcher for game chat: whole-word term matching that resists Unicode, look-alike and leetspeak evasion, for chat lines and player names.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "chatwarden",
    "moderation",
    "chat",
    "matcher",
    "blocklist",
    "text-matching"
  ],
  "homepage": "https://github.com/hainix/chatwarden/tree/main/packages/matcher#readme",
  "bugs": {
    "url": "https://github.com/hainix/chatwarden/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hainix/chatwarden.git",
    "directory": "packages/matcher"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./fixtures": {
      "types": "./dist/src/fixtures/index.d.ts",
      "default": "./dist/src/fixtures/index.js"
    },
    "./test-fixtures": {
      "types": "./dist/src/fixtures/testFixtures.d.ts",
      "default": "./dist/src/fixtures/testFixtures.js"
    }
  },
  "typesVersions": {
    "*": {
      "fixtures": [
        "dist/src/fixtures/index.d.ts"
      ],
      "test-fixtures": [
        "dist/src/fixtures/testFixtures.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist/src",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "peerDependencies": {
    "@chatwarden/core": "^0.1.0"
  },
  "devDependencies": {
    "@chatwarden/core": "0.1.6",
    "obscenity": "^0.4.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
