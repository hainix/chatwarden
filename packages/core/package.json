{
  "name": "@chatwarden/core",
  "version": "0.1.2",
  "private": false,
  "description": "Chat moderation engine for games: reports, warnings, timeouts and bans, a moderator queue and player notices. No sockets, HTTP or disk.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "chatwarden",
    "moderation",
    "chat",
    "core",
    "types"
  ],
  "homepage": "https://github.com/hainix/chatwarden/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/hainix/chatwarden/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hainix/chatwarden.git",
    "directory": "packages/core"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/src",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "devDependencies": {
    "@chatwarden/store-memory": "0.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
