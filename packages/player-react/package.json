{
  "name": "@chatwarden/player-react",
  "version": "0.1.9",
  "private": false,
  "description": "Player-facing React components for Chatwarden: the notice dialog, My record, the rules page, a report dialog and a restricted-chat line, over the player HTTP routes.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "chatwarden",
    "moderation",
    "chat",
    "react",
    "player",
    "notices"
  ],
  "homepage": "https://github.com/hainix/chatwarden/tree/main/packages/player-react#readme",
  "bugs": {
    "url": "https://github.com/hainix/chatwarden/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hainix/chatwarden.git",
    "directory": "packages/player-react"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./chat": {
      "types": "./dist/src/chat/index.d.ts",
      "default": "./dist/src/chat/index.js"
    },
    "./chat.css": "./src/chat.css"
  },
  "typesVersions": {
    "*": {
      "chat": [
        "dist/src/chat/index.d.ts"
      ]
    }
  },
  "sideEffects": [
    "./src/styles.css",
    "./src/chat.css"
  ],
  "files": [
    "dist/src",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "peerDependencies": {
    "@chatwarden/core": "^0.1.9",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@chatwarden/core": "0.1.9",
    "@chatwarden/http": "0.1.9",
    "@chatwarden/hub-react": "0.1.9",
    "@chatwarden/store-memory": "0.1.9",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "esbuild": "0.28.2",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
