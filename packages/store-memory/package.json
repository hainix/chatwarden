{
  "name": "@chatwarden/store-memory",
  "version": "0.1.1",
  "private": false,
  "description": "In-memory store for Chatwarden chat moderation, for tests, demos and single-process prototypes. Journaled and transactional; runs in a browser.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "chatwarden",
    "moderation",
    "chat",
    "memory",
    "storage",
    "testing"
  ],
  "homepage": "https://github.com/hainix/chatwarden/tree/main/packages/store-memory#readme",
  "bugs": {
    "url": "https://github.com/hainix/chatwarden/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hainix/chatwarden.git",
    "directory": "packages/store-memory"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/src",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "peerDependencies": {
    "@chatwarden/core": "^0.1.0"
  },
  "devDependencies": {
    "@chatwarden/core": "0.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
