{
  "name": "@chatwarden/discord",
  "version": "0.1.2",
  "private": false,
  "description": "Chatwarden Discord package: feeds the staff review queue into a Discord forum through a channel webhook, one thread per reported person.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "chatwarden",
    "moderation",
    "chat",
    "discord",
    "webhook",
    "review-queue"
  ],
  "homepage": "https://github.com/hainix/chatwarden/tree/main/packages/discord#readme",
  "bugs": {
    "url": "https://github.com/hainix/chatwarden/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hainix/chatwarden.git",
    "directory": "packages/discord"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/src",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "peerDependencies": {
    "@chatwarden/core": "^0.1.0"
  },
  "devDependencies": {
    "@chatwarden/core": "0.1.2",
    "@chatwarden/store-memory": "0.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
